[Unit]
Description=WhatsApp MCP gateway
Documentation=https://github.com/goodtune/whatsapp-mcp
After=network-online.target whatsapp-worker.service
Wants=whatsapp-worker.service

ConditionUser=!root

[Service]
Type=simple

EnvironmentFile=-/etc/sysconfig/whatsapp-mcp
EnvironmentFile=-%h/.config/whatsapp-mcp/env
ExecStart=/usr/bin/whatsapp-mcp

Restart=on-failure
RestartSec=30s

StandardOutput=journal
StandardError=journal

# Only sandbox directives that work in a non-root user manager. The
# Protect*/Private* knobs need CAP_SETPCAP / CAP_SYS_ADMIN and would
# fail the spawn at step CAPABILITIES with exit 218.
NoNewPrivileges=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
