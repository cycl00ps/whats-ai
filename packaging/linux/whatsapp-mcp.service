[Unit]
Description=WhatsApp MCP gateway
Documentation=https://github.com/goodtune/whatsapp-mcp
After=network-online.target whatsapp-worker.service
Wants=whatsapp-worker.service

# Per-user service: the --*-dotvault* flags read secrets with this user's
# cached dotvault login (~/.dotvault-token), and the database, media and
# WhatsApp session keys live in this user's state directory. As root it
# would do all of that as root.
ConditionUser=!root

[Service]
Type=simple

# Settings come from environment files, most specific first wins. Put
# MCP_BEARER_TOKEN, NGROK_DOMAIN etc. (see the README) in
# ~/.config/whatsapp-mcp/env, mode 0600: it holds MCP_BEARER_TOKEN.
# WHATSAPP_MCP_ARGS passes command-line flags, e.g.
#   WHATSAPP_MCP_ARGS=--ngrok-dotvault whatsapp-mcp/ngrok/authtoken
EnvironmentFile=-/etc/sysconfig/whatsapp-mcp
EnvironmentFile=-%h/.config/whatsapp-mcp/env
ExecStart=/usr/bin/whatsapp-mcp $WHATSAPP_MCP_ARGS

Restart=on-failure
RestartSec=30s

StandardOutput=journal
StandardError=journal

# Only sandbox directives that work in a non-root user manager. The
# Protect*/Private* knobs need CAP_SETPCAP / CAP_SYS_ADMIN and would
# fail the spawn at step CAPABILITIES with exit 218.
NoNewPrivileges=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
